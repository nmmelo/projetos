# Copiar para tesla.env e preencher: cp tesla.env.example tesla.env
# Lido pelo comando tesla-setup dentro do contentor (/opt/tesla/tesla.env)

# Domínio onde a chave pública está publicada (sem https://)
TESLA_DOMAIN=tesla.exemplo.com

# Credenciais da aplicação em developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Região da Fleet API: eu (Europa) | na (América do Norte / Ásia-Pacífico)
TESLA_REGION=eu

# Redirect URI registado na aplicação
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Scopes pedidos
TESLA_SCOPES="openid offline_access vehicle_device_data vehicle_cmds vehicle_charging_cmds"

# Endpoints (normalmente não é preciso mudar)
TESLA_AUTH_URL=https://auth.tesla.com/oauth2/v3/authorize
TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
