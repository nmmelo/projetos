# Copiar para tesla.env e preencher: cp tesla.env.example tesla.env
# Lido pelo comando tesla-setup dentro do contentor (/opt/tesla/tesla.env)

# Domínio onde a chave pública está publicada (sem https://)
TESLA_DOMAIN=tesla.exemplo.com

# Credenciais da aplicação em developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Região da Fleet API: eu (Europa) | na (América do Norte / Ásia-Pacífico)
TESLA_REGION=eu

# Redirect URI registado na aplicação
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Scopes pedidos (vehicle_location é preciso para /api/vehicles/<vin>/location)
TESLA_SCOPES="openid offline_access vehicle_device_data vehicle_location vehicle_cmds vehicle_charging_cmds"

# Imagem do carro (/api/vehicles/<vin>/image)
# Recomendado: códigos do URL da imagem do carro em tesla.com (conta → produtos → botão direito na imagem →
# copiar endereço → valor de "options="). Escrever SEM "$" ou entre plicas, ex.:
#   TESLA_IMAGE_OPTIONS=MT353,PPSW,W38A,IPB3     ou     TESLA_IMAGE_OPTIONS='$MT353,$PPSW,$W38A,$IPB3'
# Vazio = automático a partir da cor e jantes do carro (aproximado)
TESLA_IMAGE_MODEL=m3
TESLA_IMAGE_OPTIONS=
TESLA_IMAGE_CACHE_DIAS=30

# Endpoints (normalmente não é preciso mudar)
TESLA_AUTH_URL=https://auth.tesla.com/oauth2/v3/authorize
TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
