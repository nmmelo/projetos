# Copiar para .env e ajustar: cp .env.example .env

# Utilizador SSH (com sudo, só chave pública)
# SSH_UID deve ser igual ao UID do utilizador no NAS (id -u <utilizador>; no Synology costuma ser 1026),
# para os ficheiros em ./tesla terem o mesmo dono dentro e fora do contentor
SSH_USER=admin
SSH_UID=1001
# Chaves extra do utilizador principal, além de ssh/authorized_keys (várias separadas por ";")
SSH_PUBKEY=

# Utilizador SSH extra (opcional), ex. para outro portal de gestão; criado em cada arranque
SSH_EXTRA_USER=
SSH_EXTRA_PUBKEY=
SSH_EXTRA_SUDO=1
SSH_EXTRA_UID=

# Portas no anfitrião
HTTP_PORT=8088      # destino do Proxy Reverso do DSM
SSH_PORT=2223       # só rede local
ADMIN_PORT=8089     # portal admin, só rede local

CONTAINER_NAME=tesla-key

# Pasta dos dados (ssh/, html/, hostkeys/, tesla/). "." = pasta do projeto.
# Numa stack do Portainer a partir do Git: caminho absoluto, ex.: /volume1/docker/tesla-key
DATA_DIR=.

# Rede Docker partilhada com o portal (ver: docker network ls)
DOCKER_NETWORK=tesla-net

# Clientes, chaves, Status API e login do portal: geridos com `tesla-setup` ou no portal admin

# Origem das atualizações (./atualizar.sh): URL "raw" da pasta tesla-key no repositório
UPDATE_URL=https://raw.githubusercontent.com/<utilizador>/<repositorio>/main/docker/tesla-key
