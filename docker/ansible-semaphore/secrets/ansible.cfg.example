# Copiar para secrets/ansible.cfg e ajustar. Os caminhos com ~ são da home do utilizador que corre o Ansible.
[defaults]
interpreter_python      = auto_silent
inventory               = ~/workspace/ansible/inventory
forks                   = 5
log_path                = ~/ansible.log
module_name             = command
executable              = /bin/bash
display_skipped_hosts   = false
deprecation_warnings    = False
remote_tmp              = ~/.ansible/tmp
local_tmp               = ~/.ansible/tmp
roles_path              = ~/workspace/ansible/roles
# Utilizador nos servidores de destino e chave privada (ANSIBLE_KEY_FILE)
remote_user             = automacao
private_key_file        = ~/.ssh/automacao
remote_port             = 22
timeout                 = 10
host_key_checking       = False

[privilege_escalation]
become                  = True
become_method           = sudo
become_user             = root
become_ask_pass         = False

[ssh_connection]
transfer_method         = smart
retries                 = 3

[inventory]
enable_plugins          = host_list, script, auto, yaml, ini, toml
