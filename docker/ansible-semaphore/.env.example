# Variáveis da stack do Portainer (Stacks → stack → Environment variables → "Load variables from .env file"
# com este ficheiro preenchido, ou uma a uma). Com docker compose: cp .env.example .env
# Sem comentários no fim das linhas nem espaços depois dos valores.

# ---------------------------------------------------------------- Utilizador SSH principal (sudo, só chave pública)
# UID/GID iguais aos do anfitrião (Synology: id <utilizador> → uid=1026 gid=100(users)). Mudar obriga a novo deploy.
# Nome à escolha; evitar nomes óbvios (admin, root, administrator)
SSH_USER=
SSH_UID=1026
SSH_GID=100
# Chave(s) pública(s) para entrar por SSH (conteúdo do .pub; várias separadas por ";")
SSH_PUBKEY=

# ---------------------------------------------------------------- Utilizador extra (opcional)
# Ex.: o utilizador de automação que existe nos servidores de destino
SSH_EXTRA_USER=
# Chave(s) pública(s) para entrar por SSH com este utilizador (vazio = não entra por SSH)
SSH_EXTRA_PUBKEY=
SSH_EXTRA_SUDO=1
SSH_EXTRA_UID=

# ---------------------------------------------------------------- Ansible
# SECRETS_DIR: em alternativa às variáveis abaixo, pasta no anfitrião com os ficheiros (upload pelo File Station):
# <ANSIBLE_KEY_FILE>, .vault_pass, ansible.cfg, authorized_keys. Ex.: /volume1/docker/ansible-semaphore/secrets
SECRETS_DIR=
# Chave privada para os servidores de destino, em base64 numa linha:  base64 -w0 <chave>
ANSIBLE_PRIVATE_KEY_B64=
# Nome com que fica em ~/.ssh/ (principal e extra)
ANSIBLE_KEY_FILE=id_ansible
# Utilizador nos servidores de destino (vazio = SSH_EXTRA_USER)
ANSIBLE_REMOTE_USER=
# Vazio = ~/workspace/<PLAYBOOKS_GIT_DIR>/inventory e .../roles
ANSIBLE_INVENTORY=
ANSIBLE_ROLES_PATH=
# ansible.cfg próprio em base64 (vazio = gerado a partir de ansible.cfg.modelo):  base64 -w0 ansible.cfg
ANSIBLE_CFG_B64=
# Password do Ansible Vault
ANSIBLE_VAULT_PASSWORD=

# ---------------------------------------------------------------- Playbooks
# Vazio = volume "playbooks". Caminho absoluto = pasta no anfitrião (criada pelo Docker), ex.:
# /volume1/docker/ansible-semaphore/workspace
PLAYBOOKS_DIR=
# Repositório Git clonado no 1.º arranque para ~/workspace/<PLAYBOOKS_GIT_DIR> (vazio = não clona)
PLAYBOOKS_GIT_URL=
PLAYBOOKS_GIT_BRANCH=
PLAYBOOKS_GIT_DIR=ansible
# Repositório privado: token (GitHub: fine-grained, só leitura de Contents)
PLAYBOOKS_GIT_USER=git
PLAYBOOKS_GIT_TOKEN=

# ---------------------------------------------------------------- Semaphore
SEMAPHORE_VERSION=v2.18.31
# Conta de gestão do Semaphore; evitar nomes óbvios
SEMAPHORE_ADMIN=
SEMAPHORE_ADMIN_NAME=
SEMAPHORE_ADMIN_EMAIL=
# Password forte; só é usada no 1.º arranque
SEMAPHORE_ADMIN_PASSWORD=
# openssl rand -base64 32 — guardar; não mudar depois do 1.º arranque
SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# ---------------------------------------------------------------- Portas e nomes
SSH_PORT=2222
SEMAPHORE_PORT=3000
ANSIBLE_CONTAINER=ansible
SEMAPHORE_CONTAINER=semaphore
TZ=Europe/Lisbon
