# Copiar para .env e ajustar: cp .env.example .env
# Numa stack do Portainer: as mesmas variáveis em "Environment variables" (sem .env).
# Sem comentários no fim das linhas nem espaços depois dos valores.

# ---------------------------------------------------------------- Pastas no anfitrião
# DATA_DIR: pasta com secrets/, hostkeys/ e semaphore/.
# "." = pasta do projeto. No Portainer: caminho absoluto, ex.: /volume1/docker/ansible-semaphore
DATA_DIR=.
# PLAYBOOKS_DIR: pasta com os playbooks, inventário e roles (montada em ~/workspace e em /playbooks no Semaphore)
# No Portainer: caminho absoluto, ex.: /volume1/docker/ansible-semaphore/workspace
PLAYBOOKS_DIR=./workspace

# ---------------------------------------------------------------- Utilizador SSH principal (sudo, só chave pública)
# UID/GID iguais aos do anfitrião (Synology: id <utilizador> → uid=1026 gid=100(users)).
# Mudar SSH_USER/SSH_UID/SSH_GID obriga a reconstruir a imagem.
SSH_USER=admin
SSH_UID=1026
SSH_GID=100
# Chave(s) pública(s) para entrar por SSH, além de secrets/authorized_keys (várias separadas por ";")
SSH_PUBKEY=

# ---------------------------------------------------------------- Utilizador extra (opcional, criado em cada arranque)
# Ex.: o utilizador de automação que existe nos servidores de destino
SSH_EXTRA_USER=
# Chave(s) pública(s) para entrar por SSH com este utilizador (vazio = não entra por SSH)
SSH_EXTRA_PUBKEY=
SSH_EXTRA_SUDO=1
SSH_EXTRA_UID=

# ---------------------------------------------------------------- Ansible
# Nome do ficheiro da chave privada em secrets/ (ex.: automacao); fica em ~/.ssh/<nome>
# do utilizador principal e do extra. Tem de bater com private_key_file no ansible.cfg.
ANSIBLE_KEY_FILE=

# ---------------------------------------------------------------- Semaphore
SEMAPHORE_VERSION=v2.18.31
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Administrador
SEMAPHORE_ADMIN_EMAIL=
# Password forte; só é usada no 1.º arranque
SEMAPHORE_ADMIN_PASSWORD=
# openssl rand -base64 32 — guardar; não mudar depois do 1.º arranque
SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# ---------------------------------------------------------------- Portas e nomes
SSH_PORT=2222
SEMAPHORE_PORT=3000
ANSIBLE_CONTAINER=ansible
SEMAPHORE_CONTAINER=semaphore
TZ=Europe/Lisbon
