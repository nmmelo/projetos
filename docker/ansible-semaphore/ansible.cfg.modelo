# Modelo do /etc/ansible/ansible.cfg, preenchido pelo entrypoint a partir das variáveis:
#   @REMOTE_USER@ ← ANSIBLE_REMOTE_USER (omissão: SSH_EXTRA_USER)
#   @KEY_NAME@    ← ANSIBLE_KEY_FILE (omissão: id_ansible)
#   @INVENTORY@   ← ANSIBLE_INVENTORY (omissão: ~/workspace/<PLAYBOOKS_GIT_DIR>/inventory)
#   @ROLES@       ← ANSIBLE_ROLES_PATH (omissão: ~/workspace/<PLAYBOOKS_GIT_DIR>/roles)
# Para usar um ansible.cfg próprio: ANSIBLE_CFG_B64 ou /secrets/ansible.cfg.
[defaults]
interpreter_python      = auto_silent
inventory               = @INVENTORY@
roles_path              = @ROLES@
forks                   = 5
log_path                = ~/ansible.log
module_name             = command
executable              = /bin/bash
display_skipped_hosts   = false
deprecation_warnings    = False
remote_tmp              = ~/.ansible/tmp
local_tmp               = ~/.ansible/tmp
remote_user             = @REMOTE_USER@
private_key_file        = ~/.ssh/@KEY_NAME@
remote_port             = 22
timeout                 = 10
host_key_checking       = False

[privilege_escalation]
become                  = True
become_method           = sudo
become_user             = root
become_ask_pass         = False

[ssh_connection]
transfer_method         = smart
retries                 = 3

[inventory]
enable_plugins          = host_list, script, auto, yaml, ini, toml
