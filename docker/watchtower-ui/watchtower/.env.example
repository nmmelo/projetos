# Copiar para .env e ajustar: cp .env.example .env
# Os dois tokens têm de ser IGUAIS aos do .env do watchtower-ui.

# Imagem: a original (containrrr, já sem manutenção) ou o fork mantido nickfedor/watchtower
WATCHTOWER_IMAGE=containrrr/watchtower:latest
# API do Docker: ver a do servidor com  docker version --format '{{.Server.APIVersion}}'
# Docker 29+ (API 1.52, mínimo 1.44) -> 1.44 ; Docker mais antigo -> 1.25
DOCKER_API_VERSION=1.25
CONTAINER_NAME=watchtower
TZ=Europe/Lisbon

# Cron com 6 campos (segundos minutos horas dia mês dia-semana)
WATCHTOWER_SCHEDULE=0 0 4 * * *
WATCHTOWER_CLEANUP=true
WATCHTOWER_INCLUDE_STOPPED=false
WATCHTOWER_LABEL_ENABLE=false
WATCHTOWER_MONITOR_ONLY=false

# Tokens: openssl rand -hex 32
WATCHTOWER_HTTP_API_TOKEN=muda-me
WEBHOOK_TOKEN=muda-me

# Nome do contentor do portal na rede (destino do relatório) e rede partilhada
UI_HOST=watchtower-ui
WATCHTOWER_NETWORK=watchtower-net
