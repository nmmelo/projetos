# Copiar para .env e ajustar

# Porta da interface no anfitrião
UI_PORT=8090
TZ=Europe/Lisbon

# Nome do contentor watchtower (resolvido por DNS dentro da rede) e porta da API
WATCHTOWER_HOST=watchtower
WATCHTOWER_PORT=8080

# Rede Docker partilhada com o watchtower
WATCHTOWER_NETWORK=watchtower-net

# Tem de ser igual ao WATCHTOWER_HTTP_API_TOKEN do contentor watchtower
WATCHTOWER_HTTP_API_TOKEN=muda-me
