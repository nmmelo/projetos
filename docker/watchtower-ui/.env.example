# Copiar para .env e ajustar: cp .env.example .env

# Utilizador SSH (com sudo, só chave pública)
# SSH_UID: UID do utilizador (ex. igual ao do anfitrião: id -u <utilizador>)
SSH_USER=admin
SSH_UID=1001
# Chave(s) pública(s) do utilizador principal, além de ssh/authorized_keys (várias separadas por ";")
SSH_PUBKEY=

# Utilizador SSH extra (opcional); criado em cada arranque
SSH_EXTRA_USER=
SSH_EXTRA_PUBKEY=
SSH_EXTRA_SUDO=1
SSH_EXTRA_UID=

# Portas no anfitrião
UI_PORT=8090        # interface web, só rede local
SSH_PORT=2224       # só rede local

CONTAINER_NAME=watchtower-ui
TZ=Europe/Lisbon

# Pasta dos dados (ssh/, hostkeys/). "." = pasta do projeto.
# Numa stack do Portainer a partir do Git: caminho absoluto, ex.: /volume1/docker/watchtower-ui
DATA_DIR=.

# Watchtower: nome do contentor (resolvido por DNS dentro da rede) e porta da API
WATCHTOWER_HOST=watchtower
WATCHTOWER_PORT=8080

# Rede Docker partilhada com o watchtower (ver: docker network ls)
WATCHTOWER_NETWORK=watchtower-net

# Tem de ser igual ao WATCHTOWER_HTTP_API_TOKEN do contentor watchtower
WATCHTOWER_HTTP_API_TOKEN=muda-me
