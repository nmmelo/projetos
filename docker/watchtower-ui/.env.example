# Copiar para .env e ajustar: cp .env.example .env

# ---------------------------------------------------------------- Pasta dos dados (mounts)
# Onde ficam no anfitrião: db/ (SQLite), logs/, ssh/authorized_keys e hostkeys/
# "." = pasta do projeto. Numa stack do Portainer a partir do Git: caminho absoluto, ex.: /volume1/docker/watchtower-ui
DATA_DIR=.

# ---------------------------------------------------------------- Utilizador SSH (com sudo, só chave pública)
# SSH_UID: UID do utilizador; de preferência igual ao do anfitrião (id -u <utilizador>), para os ficheiros
# em DATA_DIR terem o mesmo dono dentro e fora do contentor. Mudar SSH_USER/SSH_UID obriga a --build.
SSH_USER=admin
SSH_UID=1001
# Chave(s) pública(s) do utilizador, além de ssh/authorized_keys (várias separadas por ";")
SSH_PUBKEY=

# Utilizador SSH extra (opcional); criado em cada arranque
SSH_EXTRA_USER=
SSH_EXTRA_PUBKEY=
SSH_EXTRA_SUDO=1
SSH_EXTRA_UID=

# ---------------------------------------------------------------- Portal
# Primeiro administrador: só é criado no 1.º arranque (base de dados vazia).
# Se ADMIN_PASSWORD ficar vazio é gerada uma password e mostrada em: docker logs watchtower-ui
ADMIN_USER=admin
ADMIN_PASSWORD=
# Dias de auditoria e relatórios guardados (o histórico de versões não é apagado)
LOG_RETENTION_DAYS=90
# Segundos entre leituras do Docker (deteção de novas versões)
SYNC_INTERVAL=60
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Proxies à frente do contentor: 1 = só o nginx interno; 2 = se houver outro proxy reverso à frente
PROXY_HOPS=1
# Token do endpoint /api/webhook (relatórios do Watchtower): openssl rand -hex 32
WEBHOOK_TOKEN=

# ---------------------------------------------------------------- Portas no anfitrião
UI_PORT=8090        # portal, só rede local
SSH_PORT=2224       # só rede local

CONTAINER_NAME=watchtower-ui
TZ=Europe/Lisbon

# ---------------------------------------------------------------- Watchtower
# Nome do contentor na rede (DNS) e porta da HTTP API
WATCHTOWER_HOST=watchtower
WATCHTOWER_PORT=8080
# Nome do contentor para ler os logs (normalmente igual a WATCHTOWER_HOST)
WATCHTOWER_CONTAINER=watchtower
# Rede Docker partilhada com o watchtower (ver: docker network ls)
WATCHTOWER_NETWORK=watchtower-net
# Tem de ser igual ao WATCHTOWER_HTTP_API_TOKEN do contentor watchtower: openssl rand -hex 32
WATCHTOWER_HTTP_API_TOKEN=muda-me
