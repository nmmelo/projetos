# O nginx:alpine substitui as variáveis ${...} no arranque.
# O token fica só no servidor; o browser nunca o vê.
server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # DNS interno do Docker: resolve o watchtower em cada pedido,
    # para a UI arrancar mesmo que o watchtower ainda não esteja ativo
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $watchtower http://${WATCHTOWER_HOST}:${WATCHTOWER_PORT};

    location / {
        try_files $uri /index.html;
    }

    # POST /api/update[?image=nginx,redis] -> /v1/update
    location = /api/update {
        limit_except POST { deny all; }
        proxy_pass         $watchtower/v1/update$is_args$args;
        proxy_set_header   Authorization "Bearer ${WATCHTOWER_HTTP_API_TOKEN}";
        proxy_read_timeout 900s;   # o update pode demorar (pull de imagens)
    }

    # GET /api/metrics -> /v1/metrics (formato Prometheus)
    location = /api/metrics {
        limit_except GET { deny all; }
        proxy_pass       $watchtower/v1/metrics;
        proxy_set_header Authorization "Bearer ${WATCHTOWER_HTTP_API_TOKEN}";
    }
}
