# ---------------------------------------------------------------- Portal
# O administrador fica em data/admin.json. Para o criar/alterar:
#   docker-compose exec -u portal portal python manage.py set-admin-password
# (Alternativa no 1.o arranque: PORTAL_ADMIN_PASSWORD_HASH, gerado com manage.py hash-password)
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD_HASH=

# Chave de cifra das passwords (opcional). Se vazio, e criada em data/fernet.key - FACA BACKUP.
PORTAL_FERNET_KEY=

# 1 se o portal for servido por HTTPS
PORTAL_COOKIE_SECURE=0

TZ=Europe/Lisbon

# ---------------------------------------------------------------- SSH (porta 2222)
# Utilizadores pessoais com sudo: data/ssh/users/<utilizador>.pub (ver README)
# As opcoes abaixo sao so para o utilizador de servico 'portal'.
# Recomendado: chave publica em data/ssh/authorized_keys (ou aqui, uma por linha)
SSH_AUTHORIZED_KEYS=
# Opcional: password SSH (vazio = so chaves)
SSH_PASSWORD=
# 1 = o utilizador portal pode usar sudo sem password (instalar pacotes, etc.)
PORTAL_SSH_SUDO=0
