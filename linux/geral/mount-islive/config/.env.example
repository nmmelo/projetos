# mount-islive - exemplo de configuração
# O ficheiro real (config/.env) é criado pelo setup.sh com chmod 600. Não editar à mão
# a password: o setup.sh cifra-a com a chave config/smtp.key.

# Mounts a validar (separados por espaço); têm de existir no /etc/fstab
MOUNTS=/mnt/nfs_backup
# Intervalo entre testes (minutos)
INTERVAL_MIN=5
# Ficheiro escrito em cada mount com a data do teste
TEST_FILE=teste.txt
# Segundos até considerar que o mount não responde
TOUCH_TIMEOUT=15
# sim = enviar alerta (uma vez) se o remount falhar; o email de "ON" é sempre enviado
NOTIFY_ON_FAIL=sim

# SMTP
SMTP_SERVER=smtp.exemplo.pt
SMTP_PORT=587
# none | starttls | ssl
SMTP_SECURITY=starttls
SMTP_TLS_VERIFY=nao
SMTP_USER=alertas@exemplo.pt
# Password cifrada (AES-256-CBC + PBKDF2) gerada pelo setup.sh
SMTP_PASSWORD_ENC=''
MAIL_FROM=alertas@exemplo.pt
# Um ou mais destinatários separados por vírgula
MAIL_TO=dba@exemplo.pt,sistemas@exemplo.pt
